<%- include('../partials/header') %>
<%
  const courses = locals.courses || [];
  const recentPosts = locals.recentPosts || [];
  const notices = locals.notices || [];
%>

<!-- Welcome Hero Banner -->
<div class="card sau-card mb-4 p-4 border-0 shadow-sm overflow-hidden">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; font-size: 1.5rem; flex-shrink: 0;">
        <i class="bi bi-person-workspace"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h1 class="h4 mb-0 fw-bold">Welcome, Prof. <%= user.fullName %></h1>
          <span class="badge bg-light text-primary border small">Faculty Portal</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
          Academic Department: <strong><%= user.departmentId ? 'Department #' + user.departmentId : 'Faculty Member' %></strong> &bull; South Asian University
        </p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/academic/posts/create" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Post Deadline
      </a>
      <a href="/notices/create" class="btn btn-sau-primary btn-sm">
        <i class="bi bi-megaphone me-1"></i> Post Notice
      </a>
    </div>
  </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-4">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Assigned Courses</span>
          <h2 class="h3 mb-0 fw-bold"><%= courses.length %></h2>
        </div>
        <div class="p-3 bg-primary-subtle text-primary rounded-circle">
          <i class="bi bi-book fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Active Teaching Load</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-4">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Enrolled Students</span>
          <% const totalStudents = courses.reduce((acc, c) => acc + parseInt(c.enrolled_count || 0, 10), 0); %>
          <h2 class="h3 mb-0 fw-bold text-success"><%= totalStudents %></h2>
        </div>
        <div class="p-3 bg-success-subtle text-success rounded-circle">
          <i class="bi bi-people fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Across all your courses</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-4">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Upcoming Events</span>
          <h2 class="h3 mb-0 fw-bold text-danger"><%= deadlines.length %></h2>
        </div>
        <div class="p-3 bg-danger-subtle text-danger rounded-circle">
          <i class="bi bi-calendar-event fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/academic/posts" class="small text-decoration-none fw-semibold">Manage Deadlines &rarr;</a>
      </div>
    </div>
  </div>
</div>

<!-- Courses & Marks Table -->
<div class="row g-4">
  <div class="col-lg-8">
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold"><i class="bi bi-journal-check text-primary me-2"></i>My Teaching Courses & Marks</h2>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-uppercase text-secondary">
            <tr>
              <th class="ps-3">Code</th>
              <th>Course Name</th>
              <th class="text-center">Enrolled</th>
              <th class="text-center">Graded</th>
              <th class="text-end pe-3">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (courses.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center py-4 text-muted small">No courses currently assigned to you.</td>
              </tr>
            <% } else { %>
              <% courses.forEach(c => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark"><%= c.code %></td>
                  <td><span class="fw-semibold small"><%= c.name %></span></td>
                  <td class="text-center"><span class="badge bg-light text-dark border"><%= c.enrolled_count %> students</span></td>
                  <td class="text-center">
                    <span class="badge <%= c.graded_count >= c.enrolled_count && c.enrolled_count > 0 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning text-dark' %>">
                      <%= c.graded_count %> / <%= c.enrolled_count %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <a href="/academic/marks/entry?course_id=<%= c.course_id %>" class="btn btn-sau-primary btn-sm py-0 px-2" style="font-size: 0.78rem;">
                      <i class="bi bi-pencil me-1"></i> Enter Marks
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <!-- Active Deadlines Card -->
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold"><i class="bi bi-calendar-check text-danger me-2"></i>Upcoming Deadlines</h2>
        <a href="/academic/posts/create" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">+ New</a>
      </div>
      <div class="card-body p-3">
        <% if (deadlines.length === 0) { %>
          <p class="text-muted small text-center my-3">No active course posts.</p>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% deadlines.forEach(d => { %>
              <div class="list-group-item px-0 py-2 border-bottom">
                <span class="badge bg-light text-dark border small"><%= d.course_code %></span>
                <span class="badge bg-primary-subtle text-primary small"><%= d.type %></span>
                <div class="fw-semibold small mt-1"><%= d.title %></div>
                <% if (d.due_date) { %>
                  <div class="text-danger small" style="font-size: 0.75rem;">
                    Due: <%= new Date(d.due_date).toLocaleDateString('en-IN') %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Campus Notices -->
    <div class="card sau-card">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold"><i class="bi bi-megaphone text-success me-2"></i>Notices</h2>
        <a href="/notices" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">All &rarr;</a>
      </div>
      <div class="card-body p-3">
        <% notices.forEach(n => { %>
          <div class="mb-2 pb-2 border-bottom">
            <a href="/notices/<%= n.notice_id %>" class="text-decoration-none text-dark fw-semibold small d-block">
              <%= n.title %>
            </a>
            <div class="text-muted" style="font-size: 0.72rem;">By <%= n.author_name %> &bull; <%= new Date(n.created_at).toLocaleDateString('en-IN') %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
