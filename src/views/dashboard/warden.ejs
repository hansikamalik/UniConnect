<%- include('../partials/header') %>

<!-- Welcome Hero Banner -->
<div class="card sau-card mb-4 p-4 border-0 shadow-sm overflow-hidden">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; font-size: 1.5rem; flex-shrink: 0;">
        <i class="bi bi-building"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h1 class="h4 mb-0 fw-bold">Warden Portal &bull; <%= user.fullName %></h1>
          <span class="badge bg-light text-primary border small">Hostel Administration</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
          Assigned Building: <strong><%= hostel ? `${hostel.name} (${hostel.code})` : 'Unassigned' %></strong> &bull; South Asian University
        </p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/hostel/complaints/manage" class="btn btn-sau-primary btn-sm">
        <i class="bi bi-tools me-1"></i> Manage Complaints
      </a>
      <a href="/notices/create" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-megaphone me-1"></i> Post Hostel Notice
      </a>
    </div>
  </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Total Complaints</span>
          <h2 class="h3 mb-0 fw-bold"><%= counts.total %></h2>
        </div>
        <div class="p-3 bg-primary-subtle text-primary rounded-circle">
          <i class="bi bi-inbox fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted"><%= hostel ? hostel.code : 'Hostel' %> Records</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Pending Review</span>
          <h2 class="h3 mb-0 fw-bold text-warning"><%= counts.pending %></h2>
        </div>
        <div class="p-3 bg-warning-subtle text-warning rounded-circle">
          <i class="bi bi-hourglass-split fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/hostel/complaints/manage?status=Pending" class="small text-decoration-none fw-semibold">Review Pending &rarr;</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">In Progress</span>
          <h2 class="h3 mb-0 fw-bold text-info"><%= counts.inProgress %></h2>
        </div>
        <div class="p-3 bg-info-subtle text-info rounded-circle">
          <i class="bi bi-tools fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/hostel/complaints/manage?status=In Progress" class="small text-decoration-none fw-semibold">Track Progress &rarr;</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Resolved</span>
          <h2 class="h3 mb-0 fw-bold text-success"><%= counts.resolved %></h2>
        </div>
        <div class="p-3 bg-success-subtle text-success rounded-circle">
          <i class="bi bi-check-circle fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Completed repairs</span>
      </div>
    </div>
  </div>
</div>

<!-- Recent Complaints Section -->
<div class="card sau-card mb-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="h6 mb-0 fw-bold"><i class="bi bi-list-task text-primary me-2"></i>Recent Maintenance Requests</h2>
    <a href="/hostel/complaints/manage" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">View All &rarr;</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light small text-uppercase text-secondary">
        <tr>
          <th class="ps-3">ID</th>
          <th>Student</th>
          <th>Room</th>
          <th>Issue</th>
          <th>Status</th>
          <th class="text-end pe-3">Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentComplaints.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-4 text-muted small">No complaints reported for your hostel.</td>
          </tr>
        <% } else { %>
          <% recentComplaints.forEach(c => { %>
            <tr>
              <td class="ps-3 fw-semibold text-muted">#<%= c.complaint_id %></td>
              <td><span class="fw-semibold small"><%= c.student_name %></span> (<%= c.enrollment_id %>)</td>
              <td><span class="badge bg-light text-dark border"><%= c.custom_hostel_id || 'N/A' %></span></td>
              <td><span class="small"><%= c.title %></span></td>
              <td>
                <span class="badge <%= c.status === 'Resolved' ? 'badge-resolved' : (c.status === 'In Progress' ? 'badge-inprogress' : 'badge-pending') %>">
                  <%= c.status %>
                </span>
              </td>
              <td class="text-end pe-3 small text-muted">
                <%= new Date(c.created_at).toLocaleDateString('en-IN') %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
