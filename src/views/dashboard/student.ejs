<%- include('../partials/header') %>

<!-- Welcome Hero Banner -->
<div class="card sau-card mb-4 p-4 border-0 shadow-sm overflow-hidden position-relative">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 position-relative z-1">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; font-size: 1.5rem; flex-shrink: 0;">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h1 class="h4 mb-0 fw-bold">Welcome back, <%= user.fullName %>!</h1>
          <span class="badge bg-light text-primary border small">Autumn 2026</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
          Enrollment ID: <strong><%= user.enrollmentId || 'N/A' %></strong> &bull; South Asian University, New Delhi
        </p>
      </div>
    </div>
    <div>
      <% if (user.customHostelId) { %>
        <span class="badge bg-primary-subtle text-primary border px-3 py-2 fs-6">
          <i class="bi bi-door-closed-fill me-1"></i> Room: <%= user.customHostelId %>
        </span>
      <% } else { %>
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fs-6">
          <i class="bi bi-house me-1"></i> Day Scholar
        </span>
      <% } %>
    </div>
  </div>
</div>

<!-- 4 Key Stat Summary Cards -->
<div class="row g-3 mb-4">
  <!-- Enrolled Courses -->
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Enrolled Courses</span>
          <h2 class="h3 mb-0 fw-bold"><%= courses.length %></h2>
        </div>
        <div class="p-3 bg-primary-subtle text-primary rounded-circle">
          <i class="bi bi-book fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/academic/marks" class="small text-decoration-none fw-semibold">View Grade Report &rarr;</a>
      </div>
    </div>
  </div>

  <!-- Mess Status -->
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Mess Subscription</span>
          <% if (messSub && messSub.status === 'OPTED_IN') { %>
            <h2 class="h5 mb-0 text-success fw-bold">
              <i class="bi bi-check-circle-fill me-1"></i> <%= messSub.payment_status %>
            </h2>
          <% } else { %>
            <h2 class="h5 mb-0 text-secondary fw-bold">Not Subscribed</h2>
          <% } %>
        </div>
        <div class="p-3 bg-warning-subtle text-warning rounded-circle">
          <i class="bi bi-cup-hot fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/mess/subscription" class="small text-decoration-none fw-semibold">Manage Dining Fees &rarr;</a>
      </div>
    </div>
  </div>

  <!-- Hostel Maintenance -->
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Hostel Status</span>
          <% if (user.customHostelId) { %>
            <% const activeComp = complaints.filter(c => c.status !== 'Resolved').length; %>
            <h2 class="h5 mb-0 fw-bold <%= activeComp > 0 ? 'text-warning' : 'text-success' %>">
              <%= activeComp > 0 ? `${activeComp} Active Issue` : 'All Good' %>
            </h2>
          <% } else { %>
            <h2 class="h6 mb-0 text-muted">Day Scholar</h2>
          <% } %>
        </div>
        <div class="p-3 bg-info-subtle text-info rounded-circle">
          <i class="bi bi-building fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <% if (user.customHostelId) { %>
          <a href="/hostel/complaints" class="small text-decoration-none fw-semibold">Room Maintenance &rarr;</a>
        <% } else { %>
          <span class="small text-muted">Non-Resident</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Upcoming Deadlines -->
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Due Events</span>
          <h2 class="h3 mb-0 fw-bold text-danger"><%= deadlines.length %></h2>
        </div>
        <div class="p-3 bg-danger-subtle text-danger rounded-circle">
          <i class="bi bi-alarm fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/academic/posts" class="small text-decoration-none fw-semibold">View Deadlines &rarr;</a>
      </div>
    </div>
  </div>
</div>

<!-- Two-Column Live Content Grid -->
<div class="row g-4">
  <!-- Left Column: Today's Dining Hall Menu & Enrolled Courses -->
  <div class="col-lg-7">
    <!-- Today's Mess Menu Card -->
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-cup-hot-fill text-warning fs-5"></i>
          <h2 class="h6 mb-0 fw-bold">Today's Dining Hall Menu</h2>
        </div>
        <a href="/mess/menu" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">Full Menu &rarr;</a>
      </div>
      <div class="card-body p-3">
        <% if (meals.length === 0) { %>
          <p class="text-muted small text-center my-3">No meal slots configured.</p>
        <% } else { %>
          <div class="row g-3">
            <% meals.forEach(meal => { %>
              <div class="col-md-4">
                <div class="p-3 bg-light rounded border h-100">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold small text-dark"><%= meal.slot_name %></span>
                    <span class="text-muted" style="font-size: 0.7rem;"><%= meal.start_time.substring(0, 5) %></span>
                  </div>
                  <div class="small text-secondary" style="font-size: 0.82rem; line-height: 1.4;">
                    <%= meal.items ? meal.items.substring(0, 75) + (meal.items.length > 75 ? '...' : '') : 'Menu pending' %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Enrolled Courses Snapshot -->
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-mortarboard-fill text-primary fs-5"></i>
          <h2 class="h6 mb-0 fw-bold">My Courses & Academic Performance</h2>
        </div>
        <a href="/academic/marks" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">Grades &rarr;</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-uppercase text-secondary">
            <tr>
              <th class="ps-3">Code</th>
              <th>Course Name</th>
              <th class="text-center">Score</th>
              <th class="text-center pe-3">Grade</th>
            </tr>
          </thead>
          <tbody>
            <% if (courses.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3 small">No active course enrollments.</td>
              </tr>
            <% } else { %>
              <% courses.forEach(c => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark"><%= c.code %></td>
                  <td><span class="small fw-semibold"><%= c.name %></span></td>
                  <td class="text-center small">
                    <%= c.marks_obtained !== null ? `${c.marks_obtained}/${c.max_marks}` : '<span class="text-muted">&ndash;</span>' %>
                  </td>
                  <td class="text-center pe-3">
                    <% if (c.grade) { %>
                      <span class="badge bg-primary px-2 py-1"><%= c.grade %></span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary small">Pending</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Column: Deadlines, Complaints & Notices -->
  <div class="col-lg-5">
    <!-- Upcoming Deadlines Card -->
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-calendar-event text-danger fs-5"></i>
          <h2 class="h6 mb-0 fw-bold">Upcoming Deadlines & Quizzes</h2>
        </div>
        <a href="/academic/posts" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">All Posts &rarr;</a>
      </div>
      <div class="card-body p-3">
        <% if (deadlines.length === 0) { %>
          <div class="text-center text-muted py-3 small">
            <i class="bi bi-check2-circle text-success fs-4 d-block mb-1"></i>
            No imminent deadlines in the next 7 days.
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% deadlines.forEach(d => { %>
              <div class="list-group-item px-0 py-2 border-bottom">
                <div class="d-flex justify-content-between align-items-start gap-1">
                  <div>
                    <span class="badge bg-light text-dark border small me-1"><%= d.course_code %></span>
                    <span class="badge <%= d.type === 'QUIZ' ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary' %> small"><%= d.type %></span>
                    <div class="fw-semibold small mt-1"><%= d.title %></div>
                  </div>
                  <% if (d.due_date) { %>
                    <span class="badge bg-danger-subtle text-danger small flex-shrink-0">
                      <%= new Date(d.due_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                    </span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Latest Campus Notices -->
    <div class="card sau-card mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-megaphone-fill text-success fs-5"></i>
          <h2 class="h6 mb-0 fw-bold">Campus Announcements</h2>
        </div>
        <a href="/notices" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">More &rarr;</a>
      </div>
      <div class="card-body p-3">
        <% if (notices.length === 0) { %>
          <p class="text-muted small text-center my-2">No active announcements.</p>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% notices.forEach(n => { %>
              <div class="list-group-item px-0 py-2 border-bottom">
                <a href="/notices/<%= n.notice_id %>" class="text-decoration-none text-dark fw-semibold small d-block">
                  <%= n.title %>
                </a>
                <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.75rem;">
                  <span><i class="bi bi-person me-1"></i><%= n.author_name %></span>
                  <span><%= new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Hostel Room Status (if resident) -->
    <% if (user.customHostelId) { %>
      <div class="card sau-card">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-tools text-info fs-5"></i>
            <h2 class="h6 mb-0 fw-bold">Room Maintenance (<%= user.customHostelId %>)</h2>
          </div>
          <a href="/hostel/complaints/new" class="btn btn-sau-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">+ Report</a>
        </div>
        <div class="card-body p-3">
          <% if (complaints.length === 0) { %>
            <div class="small text-muted text-center py-2">
              <i class="bi bi-shield-check text-success fs-4 d-block mb-1"></i>
              No pending maintenance requests for room <%= user.customHostelId %>.
            </div>
          <% } else { %>
            <% complaints.forEach(c => { %>
              <div class="p-2 mb-2 bg-light rounded border d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold small"><%= c.title %></div>
                  <div class="text-muted" style="font-size: 0.72rem;"><%= new Date(c.created_at).toLocaleDateString('en-IN') %></div>
                </div>
                <span class="badge <%= c.status === 'Resolved' ? 'badge-resolved' : (c.status === 'In Progress' ? 'badge-inprogress' : 'badge-pending') %>">
                  <%= c.status %>
                </span>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
