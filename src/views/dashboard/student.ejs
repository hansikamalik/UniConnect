<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h4 mb-1">Student Dashboard</h2>
    <p class="text-muted small mb-0">Welcome back, <%= user.fullName %> | Enrollment ID: <strong><%= user.enrollmentId || 'N/A' %></strong></p>
  </div>
  <% if (user.customHostelId) { %>
    <span class="badge bg-primary px-3 py-2">Hostel: <%= user.customHostelId %></span>
  <% } else { %>
    <span class="badge bg-secondary px-3 py-2">Day Scholar</span>
  <% } %>
</div>

<div class="row g-4">
  <!-- Academic / Marks Card -->
  <div class="col-md-6 col-lg-3">
    <div class="card sau-card h-100 p-3">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-primary-subtle text-primary p-2 rounded">
          <i class="bi bi-mortarboard fs-4"></i>
        </div>
        <h3 class="h6 mb-0">Academic & Marks</h3>
      </div>
      <p class="text-muted small mb-3">View enrolled courses, internal marks, grades, and upcoming deadlines.</p>
      <a href="/academic/marks" class="btn btn-outline-primary btn-sm mt-auto">View Grades</a>
    </div>
  </div>

  <!-- Hostel Complaints Card -->
  <div class="col-md-6 col-lg-3">
    <div class="card sau-card h-100 p-3">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-info-subtle text-info p-2 rounded">
          <i class="bi bi-building fs-4"></i>
        </div>
        <h3 class="h6 mb-0">Hostel</h3>
      </div>
      <% if (user.customHostelId) { %>
        <p class="text-muted small mb-3">Track room maintenance and submit maintenance requests.</p>
        <a href="/hostel/complaints" class="btn btn-outline-info btn-sm mt-auto">Hostel Complaints</a>
      <% } else { %>
        <p class="text-muted small mb-3">Hostel services are disabled for non-resident day scholars.</p>
        <button class="btn btn-secondary btn-sm mt-auto" disabled>Not Resident</button>
      <% } %>
    </div>
  </div>

  <!-- Mess Menu & Subscriptions Card -->
  <div class="col-md-6 col-lg-3">
    <div class="card sau-card h-100 p-3">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-warning-subtle text-warning p-2 rounded">
          <i class="bi bi-cup-hot fs-4"></i>
        </div>
        <h3 class="h6 mb-0">Mess & Dining</h3>
      </div>
      <p class="text-muted small mb-3">Check today's 3 meals and manage your monthly mess subscription.</p>
      <a href="/mess/menu" class="btn btn-outline-warning btn-sm mt-auto">Mess Services</a>
    </div>
  </div>

  <!-- Notices Card -->
  <div class="col-md-6 col-lg-3">
    <div class="card sau-card h-100 p-3">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-success-subtle text-success p-2 rounded">
          <i class="bi bi-megaphone fs-4"></i>
        </div>
        <h3 class="h6 mb-0">Noticeboard</h3>
      </div>
      <p class="text-muted small mb-3">Read official university broadcasts and circulars.</p>
      <a href="/notices" class="btn btn-outline-success btn-sm mt-auto">View Notices</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
