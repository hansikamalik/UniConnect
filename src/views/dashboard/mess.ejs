<%- include('../partials/header') %>
<%
  const stats = locals.stats || { pending: 0, active: 0, cashPending: 0, total: 0 };
  const todayMeals = locals.todayMeals || [];
  const pendingSubscriptions = locals.pendingSubscriptions || [];
%>

<!-- Welcome Hero Banner -->
<div class="card sau-card mb-4 p-4 border-0 shadow-sm overflow-hidden">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; font-size: 1.5rem; flex-shrink: 0;">
        <i class="bi bi-cup-hot-fill"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h1 class="h4 mb-0 fw-bold">Mess Administration Console &bull; <%= user.fullName %></h1>
          <span class="badge bg-light text-dark border small">Dining Committee</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
          Daily 3-Meal Management &amp; Fee Verifications &bull; South Asian University
        </p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/mess/menu/edit" class="btn btn-sau-primary btn-sm">
        <i class="bi bi-pencil-square me-1"></i> Update Menu
      </a>
      <a href="/mess/subscriptions/manage" class="btn btn-outline-success btn-sm">
        <i class="bi bi-cash-stack me-1"></i> Verify Fees
      </a>
    </div>
  </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Awaiting Verification</span>
          <h2 class="h3 mb-0 fw-bold text-warning"><%= stats.pending %></h2>
        </div>
        <div class="p-3 bg-warning-subtle text-warning rounded-circle">
          <i class="bi bi-hourglass-split fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <a href="/mess/subscriptions/manage?status=PENDING_VERIFICATION" class="small text-decoration-none fw-semibold">Verify Proofs &rarr;</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Verified Subscriptions</span>
          <h2 class="h3 mb-0 fw-bold text-success"><%= stats.verified %></h2>
        </div>
        <div class="p-3 bg-success-subtle text-success rounded-circle">
          <i class="bi bi-check-circle fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Paid for <%= currentMonth %></span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Rejected Receipts</span>
          <h2 class="h3 mb-0 fw-bold text-danger"><%= stats.rejected %></h2>
        </div>
        <div class="p-3 bg-danger-subtle text-danger rounded-circle">
          <i class="bi bi-x-circle fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Invalid UTRs / blurred</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card sau-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block mb-1">Total Submissions</span>
          <h2 class="h3 mb-0 fw-bold text-primary"><%= stats.total %></h2>
        </div>
        <div class="p-3 bg-primary-subtle text-primary rounded-circle">
          <i class="bi bi-receipt-cutoff fs-4"></i>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <span class="small text-muted">Active Month: <%= currentMonth %></span>
      </div>
    </div>
  </div>
</div>

<!-- Today's 3-Meal Menu Status -->
<div class="card sau-card mb-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="h6 mb-0 fw-bold"><i class="bi bi-calendar3 text-warning me-2"></i>Today's Published Dining Menu</h2>
    <a href="/mess/menu/edit" class="btn btn-sau-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">Edit Menu &rarr;</a>
  </div>
  <div class="card-body p-3">
    <div class="row g-3">
      <% meals.forEach(meal => { %>
        <div class="col-md-4">
          <div class="p-3 bg-light rounded border h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="fw-bold small text-dark"><%= meal.slot_name %></span>
              <span class="badge bg-secondary-subtle text-secondary small"><%= meal.start_time.substring(0, 5) %> &ndash; <%= meal.end_time.substring(0, 5) %></span>
            </div>
            <div class="small text-secondary" style="font-size: 0.85rem; line-height: 1.5;">
              <%= meal.items || '<em>No menu items published yet.</em>' %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
