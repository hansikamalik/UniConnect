<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h4 mb-1">Mess Administration Dashboard</h2>
    <p class="text-muted small mb-0">Welcome, <%= user.fullName %> | Role: <strong>Mess Admin</strong></p>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card sau-card h-100 p-4">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-warning-subtle text-warning p-2 rounded">
          <i class="bi bi-calendar3 fs-3"></i>
        </div>
        <h3 class="h5 mb-0">Daily Mess Menu Management</h3>
      </div>
      <p class="text-muted small mb-3">Update daily menus for Breakfast (08:30–10:30), Lunch (12:30–14:30), and Dinner (19:30–21:30).</p>
      <a href="/mess/menu/edit" class="btn btn-sau-primary btn-sm mt-auto">Update Menus</a>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card sau-card h-100 p-4">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="bg-success-subtle text-success p-2 rounded">
          <i class="bi bi-cash-stack fs-3"></i>
        </div>
        <h3 class="h5 mb-0">Mess Subscriptions & Fees</h3>
      </div>
      <p class="text-muted small mb-3">Verify student UPI payments, approve/reject submitted proofs, and record manual cash receipts.</p>
      <a href="/mess/subscriptions/manage" class="btn btn-outline-success btn-sm mt-auto">Verify Subscriptions</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
