<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'UniConnect' %></title>
  <!-- Bootstrap 5 CSS via CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom SAU Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-sau mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <i class="bi bi-mortarboard-fill"></i>
        <span>UniConnect</span>
        <span class="badge bg-light text-primary ms-1" style="font-size: 0.65rem; font-weight: 600;">SAU</span>
      </a>
      <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <i class="bi bi-list"></i>
      </button>

      <div class="collapse navbar-collapse" id="navContent">
        <% if (locals.user) { %>
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
            </li>

            <% if (user.role === 'Student') { %>
              <li class="nav-item">
                <a class="nav-link" href="/academic/marks"><i class="bi bi-journal-bookmark me-1"></i> Grades</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/academic/posts"><i class="bi bi-calendar-event me-1"></i> Deadlines</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/mess/menu"><i class="bi bi-cup-hot me-1"></i> Mess</a>
              </li>
              <% if (user.customHostelId) { %>
                <li class="nav-item">
                  <a class="nav-link" href="/hostel/complaints"><i class="bi bi-building me-1"></i> Hostel</a>
                </li>
              <% } %>
            <% } %>

            <% if (user.role === 'Faculty') { %>
              <li class="nav-item">
                <a class="nav-link" href="/academic/marks/entry"><i class="bi bi-pencil-square me-1"></i> Marks Entry</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/academic/posts"><i class="bi bi-calendar-plus me-1"></i> Deadlines</a>
              </li>
            <% } %>

            <% if (user.role === 'Warden') { %>
              <li class="nav-item">
                <a class="nav-link" href="/hostel/complaints/manage"><i class="bi bi-tools me-1"></i> Complaints</a>
              </li>
            <% } %>

            <% if (user.role === 'Mess Admin') { %>
              <li class="nav-item">
                <a class="nav-link" href="/mess/menu"><i class="bi bi-calendar3 me-1"></i> Menus</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/mess/subscriptions/manage"><i class="bi bi-cash-stack me-1"></i> Subscriptions</a>
              </li>
            <% } %>

            <% if (user.role === 'Admin') { %>
              <li class="nav-item">
                <a class="nav-link" href="/admin/users"><i class="bi bi-people me-1"></i> Users</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/courses"><i class="bi bi-book me-1"></i> Courses</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/audit"><i class="bi bi-journal-text me-1"></i> Audit Trail</a>
              </li>
            <% } %>

            <li class="nav-item">
              <a class="nav-link" href="/notices"><i class="bi bi-megaphone me-1"></i> Notices</a>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-3">
            <div class="text-white text-end">
              <div class="fw-semibold small"><%= user.fullName %></div>
              <div class="text-white-50" style="font-size: 0.75rem;"><%= user.role %> <%= user.enrollmentId ? `(${user.enrollmentId})` : '' %></div>
            </div>
            <a href="/auth/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
          </div>
        <% } else { %>
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
            </li>
          </ul>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container mb-5">
