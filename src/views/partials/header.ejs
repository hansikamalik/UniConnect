<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'UniConnect' %></title>
  <!-- Bootstrap 5 CSS via CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom SAU Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-sau mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <i class="bi bi-mortarboard-fill"></i>
        <span>UniConnect</span>
        <span class="badge bg-light text-primary ms-1" style="font-size: 0.65rem; font-weight: 600;">SAU</span>
      </a>
      <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <i class="bi bi-list"></i>
      </button>

      <div class="collapse navbar-collapse" id="navContent">
        <% if (locals.user) { %>
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/notices"><i class="bi bi-megaphone me-1"></i> Notices</a>
            </li>
          </ul>
          <div class="d-flex align-items-center gap-3">
            <div class="text-white text-end">
              <div class="fw-semibold small"><%= user.fullName %></div>
              <div class="text-white-50" style="font-size: 0.75rem;"><%= user.role %> <%= user.enrollmentId ? `(${user.enrollmentId})` : '' %></div>
            </div>
            <a href="/auth/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
          </div>
        <% } else { %>
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
            </li>
          </ul>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container mb-5">
