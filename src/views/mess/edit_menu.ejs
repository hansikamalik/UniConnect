<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/mess/menu?date=<%= targetDate %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        <h2 class="h4 mb-0 ms-2">Update Daily Mess Menu</h2>
      </div>
      <p class="text-muted small">Update menu offerings for South Asian University dining hall. Exactly 3 daily meal slots.</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/mess/menu/edit" method="POST" class="mt-3">
        <div class="mb-4">
          <label for="menu_date" class="form-label fw-semibold small">Menu Date</label>
          <input type="date" class="form-control" id="menu_date" name="menu_date" value="<%= targetDate %>" required>
        </div>

        <div class="border-top pt-3">
          <h5 class="h6 text-primary mb-3"><i class="bi bi-clock-history me-1"></i> Meal Slots</h5>

          <% slots.forEach(slot => { %>
            <div class="mb-4 p-3 bg-light rounded border">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label for="slot-<%= slot.slot_id %>" class="form-label fw-bold mb-0">
                  <%= slot.slot_name %>
                </label>
                <span class="badge bg-secondary-subtle text-secondary small">
                  <%= slot.start_time.substring(0, 5) %> &ndash; <%= slot.end_time.substring(0, 5) %>
                </span>
              </div>
              <textarea class="form-control" id="slot-<%= slot.slot_id %>" name="items[<%= slot.slot_id %>]" rows="3" placeholder="Enter dishes, bread, beverage, etc. (one per line)"><%= slot.items || '' %></textarea>
            </div>
          <% }) %>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <a href="/mess/menu?date=<%= targetDate %>" class="btn btn-light border">Cancel</a>
          <button type="submit" class="btn btn-sau-primary">
            <i class="bi bi-check-circle me-1"></i> Save Menu
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
