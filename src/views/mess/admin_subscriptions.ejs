<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Mess Subscriptions & Fee Verification</h1>
    <p class="text-muted small mb-0">Verify student online fee receipts and record cash payments</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <!-- Month filter -->
    <form action="/mess/subscriptions/manage" method="GET" class="d-flex align-items-center gap-2">
      <input type="month" class="form-control form-control-sm" name="month" value="<%= monthYear %>" onchange="this.form.submit()">
      <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button></noscript>
    </form>
    <!-- Record cash payment button -->
    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#cashModal">
      <i class="bi bi-cash-stack me-1"></i> + Record Cash Payment
    </button>
  </div>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success alert-dismissible fade show small" role="alert">
    <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger alert-dismissible fade show small" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Filter tabs -->
<div class="btn-group mb-3" role="group">
  <a href="/mess/subscriptions/manage?month=<%= monthYear %>&status=ALL" class="btn btn-sm <%= statusFilter === 'ALL' ? 'btn-primary' : 'btn-outline-secondary' %>">All</a>
  <a href="/mess/subscriptions/manage?month=<%= monthYear %>&status=PENDING_VERIFICATION" class="btn btn-sm <%= statusFilter === 'PENDING_VERIFICATION' ? 'btn-warning text-dark' : 'btn-outline-secondary' %>">Pending Verification</a>
  <a href="/mess/subscriptions/manage?month=<%= monthYear %>&status=VERIFIED" class="btn btn-sm <%= statusFilter === 'VERIFIED' ? 'btn-success text-white' : 'btn-outline-secondary' %>">Verified</a>
  <a href="/mess/subscriptions/manage?month=<%= monthYear %>&status=REJECTED" class="btn btn-sm <%= statusFilter === 'REJECTED' ? 'btn-danger text-white' : 'btn-outline-secondary' %>">Rejected</a>
</div>

<% if (subscriptions.length === 0) { %>
  <div class="card sau-card p-5 text-center text-muted">
    <i class="bi bi-receipt-cutoff fs-1 mb-2 text-secondary"></i>
    <h5>No subscriptions found for <%= monthYear %></h5>
    <p class="small mb-0">No records match the current filter criteria.</p>
  </div>
<% } else { %>
  <div class="card sau-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase text-secondary">
          <tr>
            <th class="ps-3">Student</th>
            <th>Room</th>
            <th>Status</th>
            <th>Method</th>
            <th>Payment Status</th>
            <th>Proof / UTR</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% subscriptions.forEach(sub => { %>
            <tr>
              <td class="ps-3">
                <div class="fw-semibold text-dark"><%= sub.student_name %></div>
                <div class="text-muted small"><%= sub.enrollment_id %></div>
              </td>
              <td><span class="badge bg-light text-dark border"><%= sub.custom_hostel_id || 'Day Scholar' %></span></td>
              <td>
                <% if (sub.status === 'OPTED_IN') { %>
                  <span class="badge bg-success-subtle text-success">Opted In</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary">Opted Out</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= sub.payment_method || 'N/A' %></span>
              </td>
              <td>
                <% if (sub.payment_status === 'VERIFIED') { %>
                  <span class="badge badge-verified px-2 py-1"><i class="bi bi-shield-check me-1"></i>Verified</span>
                <% } else if (sub.payment_status === 'PENDING_VERIFICATION') { %>
                  <span class="badge badge-pending px-2 py-1"><i class="bi bi-clock-history me-1"></i>Pending</span>
                <% } else if (sub.payment_status === 'REJECTED') { %>
                  <span class="badge badge-rejected px-2 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                <% } else { %>
                  <span class="badge bg-secondary px-2 py-1"><%= sub.payment_status %></span>
                <% } %>
              </td>
              <td>
                <% if (sub.payment_proof_url) { %>
                  <a href="<%= sub.payment_proof_url %>" target="_blank" class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.8rem;">
                    <i class="bi bi-image me-1"></i> View Proof
                  </a>
                  <% if (sub.transaction_id) { %>
                    <div class="small text-muted mt-1" style="font-size: 0.75rem;">UTR: <%= sub.transaction_id %></div>
                  <% } %>
                <% } else if (sub.payment_method === 'CASH') { %>
                  <span class="small text-success"><i class="bi bi-cash me-1"></i> Cash Receipt</span>
                <% } else { %>
                  <span class="small text-muted">No proof</span>
                <% } %>
              </td>
              <td class="text-end pe-3">
                <% if (sub.payment_status === 'PENDING_VERIFICATION') { %>
                  <div class="btn-group btn-group-sm">
                    <form action="/mess/subscriptions/<%= sub.subscription_id %>/verify" method="POST" class="d-inline">
                      <input type="hidden" name="action" value="APPROVE">
                      <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approve</button>
                    </form>
                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-<%= sub.subscription_id %>">
                      <i class="bi bi-x-lg"></i> Reject
                    </button>
                  </div>

                  <!-- Reject Modal -->
                  <div class="modal fade text-start" id="rejectModal-<%= sub.subscription_id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form action="/mess/subscriptions/<%= sub.subscription_id %>/verify" method="POST">
                          <input type="hidden" name="action" value="REJECT">
                          <div class="modal-header">
                            <h5 class="modal-title h6 text-danger">Reject Payment Verification</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <p class="small text-muted mb-2">Provide reason for rejection (e.g. invalid UTR, blurred screenshot, amount mismatch):</p>
                            <textarea class="form-control form-control-sm" name="remarks" rows="3" placeholder="Rejection reason..." required></textarea>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger btn-sm">Reject Submission</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <span class="small text-muted">&bull;&bull;&bull;</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- Record Cash Payment Modal -->
<div class="modal fade" id="cashModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/mess/subscriptions/cash" method="POST">
        <div class="modal-header">
          <h5 class="modal-title h6 text-success"><i class="bi bi-cash-stack me-1"></i> Record Cash Payment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="student_enrollment_id" class="form-label fw-semibold small">Student Enrollment ID</label>
            <input type="text" class="form-control form-control-sm" id="student_enrollment_id" name="student_enrollment_id" placeholder="e.g. SAU/2026/CS/001" required>
          </div>
          <div class="mb-3">
            <label for="cash_month_year" class="form-label fw-semibold small">Subscription Month</label>
            <input type="month" class="form-control form-control-sm" id="cash_month_year" name="month_year" value="<%= monthYear %>" required>
          </div>
          <div class="mb-3">
            <label for="cash_remarks" class="form-label fw-semibold small">Remarks / Cash Receipt Number</label>
            <textarea class="form-control form-control-sm" id="cash_remarks" name="remarks" rows="2" placeholder="e.g. Receipt #8942 issued at Mess Office"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success btn-sm">Confirm & Verify Payment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
