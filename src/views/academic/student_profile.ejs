<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5 mb-4">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 52px; height: 52px;">
            <%= student.full_name.charAt(0) %>
          </div>
          <div>
            <h2 class="h4 mb-0 fw-bold"><%= student.full_name %></h2>
            <div class="text-muted small"><code><%= student.enrollment_id %></code> &bull; <code>@<%= student.username %></code></div>
          </div>
        </div>
        <span class="badge bg-primary-subtle text-primary px-3 py-2 fs-6">Enrolled Student</span>
      </div>

      <div class="row g-3 py-3 border-top border-bottom my-3">
        <div class="col-sm-6">
          <div class="text-muted small mb-1">Institutional Email</div>
          <div class="fw-semibold"><i class="bi bi-envelope me-1 text-primary"></i> <%= student.email %></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small mb-1">Hostel Residency Status</div>
          <div class="fw-semibold">
            <i class="bi bi-building me-1"></i>
            <%= student.custom_hostel_id ? `Resident Student (Room: ${student.custom_hostel_id})` : 'Day Scholar' %>
          </div>
        </div>
      </div>

      <h5 class="h6 text-primary fw-bold mt-2 mb-3">
        <i class="bi bi-journal-check me-1"></i> Course Performance Under Your Instruction
      </h5>

      <% if (sharedCourses && sharedCourses.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
              <tr>
                <th>Course Code</th>
                <th>Course Title</th>
                <th class="text-center">Marks Obtained</th>
                <th class="text-center">Max Marks</th>
                <th class="text-center">Grade</th>
              </tr>
            </thead>
            <tbody>
              <% sharedCourses.forEach(c => { %>
                <tr>
                  <td class="fw-semibold small"><code><%= c.code %></code></td>
                  <td class="small"><%= c.name %></td>
                  <td class="text-center small">
                    <%= c.marks_obtained !== null && c.marks_obtained !== undefined ? c.marks_obtained : 'Not Entered' %>
                  </td>
                  <td class="text-center small">
                    <%= c.max_marks || '&ndash;' %>
                  </td>
                  <td class="text-center">
                    <% if (c.grade) { %>
                      <span class="badge bg-success-subtle text-success"><%= c.grade %></span>
                    <% } else { %>
                      <span class="text-muted small">&ndash;</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted small">No active shared course performance records.</p>
      <% } %>

      <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a href="/academic/marks/entry" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Return to Course List
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
