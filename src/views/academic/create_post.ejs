<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/academic/posts" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        <h2 class="h4 mb-0 ms-2">Create Course Deadline / Content</h2>
      </div>
      <p class="text-muted small">Notify enrolled students about upcoming quizzes, lab tests, assignment deadlines, or shared materials.</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/academic/posts/create" method="POST" class="mt-3">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="course_id" class="form-label fw-semibold small">Course</label>
            <select class="form-select" id="course_id" name="course_id" required>
              <option value="" disabled selected>Select course</option>
              <% courses.forEach(c => { %>
                <option value="<%= c.course_id %>"><%= c.code %>: <%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="type" class="form-label fw-semibold small">Post Type</label>
            <select class="form-select" id="type" name="type" required>
              <option value="QUIZ">Quiz / Class Test</option>
              <option value="LAB_EVALUATION">Lab Evaluation</option>
              <option value="ASSIGNMENT">Assignment Due Date</option>
              <option value="COURSE_CONTENT">Course Content / Material</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label for="title" class="form-label fw-semibold small">Title</label>
          <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Quiz 2 on Graph Algorithms / Assignment 3 Submission" required>
        </div>

        <div class="mb-3">
          <label for="due_date" class="form-label fw-semibold small">Due Date & Time (Optional for general content)</label>
          <input type="datetime-local" class="form-control" id="due_date" name="due_date">
        </div>

        <div class="mb-4">
          <label for="description" class="form-label fw-semibold small">Instructions / Description</label>
          <textarea class="form-control" id="description" name="description" rows="5" placeholder="Specify syllabus, venue, guidelines, or submission instructions..." required></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/academic/posts" class="btn btn-light border">Cancel</a>
          <button type="submit" class="btn btn-sau-primary">
            <i class="bi bi-send me-1"></i> Publish Post
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
