<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Course Deadlines & Content</h1>
    <p class="text-muted small mb-0">Upcoming quizzes, lab evaluations, assignments, and study materials</p>
  </div>
  <% if (canCreate) { %>
    <a href="/academic/posts/create" class="btn btn-sau-primary btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Post Announcement / Deadline
    </a>
  <% } %>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success alert-dismissible fade show small" role="alert">
    <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger alert-dismissible fade show small" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (posts.length === 0) { %>
  <div class="card sau-card p-5 text-center text-muted">
    <i class="bi bi-calendar-check fs-1 mb-2 text-secondary"></i>
    <h5>No upcoming deadlines or posts</h5>
    <p class="small mb-0">No active quizzes, evaluations, or materials for your courses.</p>
  </div>
<% } else { %>
  <div class="row g-3">
    <% posts.forEach(post => { %>
      <div class="col-12">
        <div class="card sau-card p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-2">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-light text-dark border fw-bold"><%= post.course_code %></span>
                <% if (post.type === 'QUIZ') { %>
                  <span class="badge bg-danger-subtle text-danger"><i class="bi bi-question-circle me-1"></i>QUIZ</span>
                <% } else if (post.type === 'LAB_EVALUATION') { %>
                  <span class="badge bg-warning-subtle text-warning text-dark"><i class="bi bi-laptop me-1"></i>LAB EVALUATION</span>
                <% } else if (post.type === 'ASSIGNMENT') { %>
                  <span class="badge bg-primary-subtle text-primary"><i class="bi bi-file-earmark-text me-1"></i>ASSIGNMENT</span>
                <% } else { %>
                  <span class="badge bg-info-subtle text-info"><i class="bi bi-journal-text me-1"></i>COURSE CONTENT</span>
                <% } %>
              </div>
              <h2 class="h5 fw-bold mb-1"><%= post.title %></h2>
            </div>
            <% if (post.due_date) { %>
              <div class="text-md-end">
                <div class="small text-danger fw-semibold">
                  <i class="bi bi-alarm me-1"></i> Due: <%= new Date(post.due_date).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="text-secondary small mb-3" style="white-space: pre-wrap; line-height: 1.6;">
            <%= post.description %>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="font-size: 0.8rem;">
            <span class="text-muted">
              <i class="bi bi-person me-1"></i> Posted by Prof. <%= post.faculty_name %> &bull; <%= new Date(post.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
            </span>
            <% if (canCreate) { %>
              <form action="/academic/posts/<%= post.post_id %>/delete" method="POST" onsubmit="return confirm('Delete this post?');">
                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">
                  <i class="bi bi-trash"></i> Delete
                </button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
