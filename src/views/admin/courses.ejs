<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Courses & Enrollments Management</h1>
    <p class="text-muted small mb-0">Manage course catalogue, assign faculty instructors, and enroll students</p>
  </div>
  <button type="button" class="btn btn-sau-primary" data-bs-toggle="modal" data-bs-target="#createCourseModal">
    <i class="bi bi-journal-plus me-1"></i> + Create Course
  </button>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success alert-dismissible fade show small" role="alert">
    <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger alert-dismissible fade show small" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card sau-card">
      <div class="card-header bg-white py-3 border-bottom">
        <h2 class="h5 mb-0 fw-bold">Active Courses</h2>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-uppercase text-secondary">
            <tr>
              <th class="ps-3">Code</th>
              <th>Course Name</th>
              <th>Department</th>
              <th class="text-center">Instructors</th>
              <th class="text-center">Enrolled Students</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(c => { %>
              <tr>
                <td class="ps-3 fw-bold text-dark"><%= c.code %></td>
                <td><span class="fw-semibold"><%= c.name %></span></td>
                <td><span class="badge bg-light text-secondary border"><%= c.department_name %></span></td>
                <td class="text-center"><span class="badge bg-primary-subtle text-primary"><%= c.faculty_count %> Faculty</span></td>
                <td class="text-center"><span class="badge bg-success-subtle text-success"><%= c.student_count %> Students</span></td>
                <td class="text-end pe-3">
                  <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#assignFacultyModal-<%= c.course_id %>" style="font-size: 0.8rem;">
                    <i class="bi bi-person-badge me-1"></i> Assign Faculty
                  </button>
                  <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#enrollStudentModal-<%= c.course_id %>" style="font-size: 0.8rem;">
                    <i class="bi bi-person-plus me-1"></i> Enroll Student
                  </button>

                  <!-- Modal: Assign Faculty -->
                  <div class="modal fade text-start" id="assignFacultyModal-<%= c.course_id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form action="/admin/courses/assign-faculty" method="POST">
                          <input type="hidden" name="course_id" value="<%= c.course_id %>">
                          <div class="modal-header">
                            <h5 class="modal-title h6">Assign Instructor to <%= c.code %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <label class="form-label fw-semibold small">Select Faculty Member</label>
                            <select class="form-select form-select-sm" name="faculty_id" required>
                              <option value="" disabled selected>Choose faculty</option>
                              <% facultyList.forEach(f => { %>
                                <option value="<%= f.faculty_id %>"><%= f.full_name %> (<%= f.username %>)</option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sau-primary btn-sm">Assign Instructor</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Modal: Enroll Student -->
                  <div class="modal fade text-start" id="enrollStudentModal-<%= c.course_id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form action="/admin/courses/enroll-student" method="POST">
                          <input type="hidden" name="course_id" value="<%= c.course_id %>">
                          <div class="modal-header">
                            <h5 class="modal-title h6">Enroll Student in <%= c.code %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <label class="form-label fw-semibold small">Select Student</label>
                            <select class="form-select form-select-sm" name="student_id" required>
                              <option value="" disabled selected>Choose student</option>
                              <% studentsList.forEach(s => { %>
                                <option value="<%= s.student_id %>"><%= s.enrollment_id %> &bull; <%= s.full_name %></option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success btn-sm">Enroll Student</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Create Course -->
<div class="modal fade" id="createCourseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/courses/create" method="POST">
        <div class="modal-header">
          <h5 class="modal-title h6">Create New Academic Course</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="code" class="form-label fw-semibold small">Course Code</label>
            <input type="text" class="form-control form-control-sm" id="code" name="code" placeholder="e.g. CS101" required>
          </div>
          <div class="mb-3">
            <label for="name" class="form-label fw-semibold small">Course Name</label>
            <input type="text" class="form-control form-control-sm" id="name" name="name" placeholder="e.g. Introduction to Programming" required>
          </div>
          <div class="mb-3">
            <label for="department_id" class="form-label fw-semibold small">Academic Department</label>
            <select class="form-select form-select-sm" id="department_id" name="department_id" required>
              <option value="" disabled selected>Select department</option>
              <% departments.forEach(d => { %>
                <option value="<%= d.department_id %>"><%= d.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sau-primary btn-sm">Create Course</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
