<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/admin/users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        <h2 class="h4 mb-0 ms-2">Provision New University Account</h2>
      </div>
      <p class="text-muted small">Create an authenticated identity for a student, faculty instructor, warden, mess admin, or administrator.</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/admin/users/create" method="POST" class="mt-3">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="username" class="form-label fw-semibold small">Username</label>
            <input type="text" class="form-control" id="username" name="username" placeholder="e.g. john.doe" required autofocus>
          </div>
          <div class="col-md-6">
            <label for="password" class="form-label fw-semibold small">Initial Password</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="Temporary password" required>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="full_name" class="form-label fw-semibold small">Full Name</label>
            <input type="text" class="form-control" id="full_name" name="full_name" placeholder="e.g. John Doe" required>
          </div>
          <div class="col-md-6">
            <label for="email" class="form-label fw-semibold small">Email Address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="e.g. john@sau.int" required>
          </div>
        </div>

        <div class="mb-4">
          <label for="role" class="form-label fw-semibold small">Account Role</label>
          <select class="form-select" id="role" name="role" required onchange="handleRoleChange(this.value)">
            <option value="Student" selected>Student</option>
            <option value="Faculty">Faculty</option>
            <option value="Warden">Hostel Warden</option>
            <option value="Mess Admin">Mess Admin</option>
            <option value="Admin">Administrator</option>
          </select>
        </div>

        <!-- Role-Specific Profile Sections -->
        <div id="studentFields" class="p-3 bg-light rounded border mb-4">
          <h5 class="h6 text-primary mb-3"><i class="bi bi-mortarboard me-1"></i> Student Profile Details</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="enrollment_id" class="form-label fw-semibold small">Universal Enrollment ID *</label>
              <input type="text" class="form-control form-control-sm" id="enrollment_id" name="enrollment_id" placeholder="e.g. SAU/2026/CS/001">
            </div>
            <div class="col-md-6">
              <label for="custom_hostel_id" class="form-label fw-semibold small">Hostel Room ID (Optional for Day Scholars)</label>
              <input type="text" class="form-control form-control-sm" id="custom_hostel_id" name="custom_hostel_id" placeholder="e.g. BH1-304 (Leave blank for Day Scholar)">
            </div>
          </div>
        </div>

        <div id="facultyFields" class="p-3 bg-light rounded border mb-4" style="display: none;">
          <h5 class="h6 text-primary mb-3"><i class="bi bi-building me-1"></i> Faculty Profile Details</h5>
          <div>
            <label for="department_id" class="form-label fw-semibold small">Academic Department *</label>
            <select class="form-select form-select-sm" id="department_id" name="department_id">
              <option value="" disabled selected>Select department</option>
              <% departments.forEach(d => { %>
                <option value="<%= d.department_id %>"><%= d.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div id="wardenFields" class="p-3 bg-light rounded border mb-4" style="display: none;">
          <h5 class="h6 text-primary mb-3"><i class="bi bi-door-open me-1"></i> Warden Assignment</h5>
          <div>
            <label for="hostel_id" class="form-label fw-semibold small">Assigned Hostel Building</label>
            <select class="form-select form-select-sm" id="hostel_id" name="hostel_id">
              <option value="">Select hostel to assign</option>
              <% hostels.forEach(h => { %>
                <option value="<%= h.hostel_id %>"><%= h.name %> (<%= h.code %>)</option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/admin/users" class="btn btn-light border">Cancel</a>
          <button type="submit" class="btn btn-sau-primary">
            <i class="bi bi-check2-circle me-1"></i> Provision Account
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function handleRoleChange(role) {
    document.getElementById('studentFields').style.display = role === 'Student' ? 'block' : 'none';
    document.getElementById('facultyFields').style.display = role === 'Faculty' ? 'block' : 'none';
    document.getElementById('wardenFields').style.display = role === 'Warden' ? 'block' : 'none';
  }
</script>

<%- include('../partials/footer') %>
