<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">My Hostel Complaints</h1>
    <p class="text-muted small mb-0">Track maintenance and room service requests for room <strong><%= customHostelId %></strong></p>
  </div>
  <a href="/hostel/complaints/new" class="btn btn-sau-primary">
    <i class="bi bi-plus-circle me-1"></i> Submit New Complaint
  </a>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success alert-dismissible fade show small" role="alert">
    <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger alert-dismissible fade show small" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (complaints.length === 0) { %>
  <div class="card sau-card p-5 text-center text-muted">
    <i class="bi bi-check2-circle fs-1 mb-2 text-success"></i>
    <h5>No complaints on record</h5>
    <p class="small mb-3">You have not reported any maintenance or facility issues.</p>
    <a href="/hostel/complaints/new" class="btn btn-outline-primary btn-sm mx-auto">Report an Issue</a>
  </div>
<% } else { %>
  <div class="card sau-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase text-secondary">
          <tr>
            <th class="ps-4">ID</th>
            <th>Title</th>
            <th>Hostel</th>
            <th>Status</th>
            <th>Submitted</th>
            <th>Resolution Remarks</th>
          </tr>
        </thead>
        <tbody>
          <% complaints.forEach(c => { %>
            <tr>
              <td class="ps-4 fw-semibold text-muted">#<%= c.complaint_id %></td>
              <td>
                <div class="fw-semibold text-dark"><%= c.title %></div>
                <div class="text-muted small text-truncate" style="max-width: 320px;"><%= c.description %></div>
              </td>
              <td><span class="badge bg-light text-dark border"><%= c.hostel_name %> (<%= c.hostel_code %>)</span></td>
              <td>
                <% if (c.status === 'Pending') { %>
                  <span class="badge badge-pending px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                <% } else if (c.status === 'In Progress') { %>
                  <span class="badge badge-inprogress px-2 py-1"><i class="bi bi-arrow-repeat me-1"></i>In Progress</span>
                <% } else if (c.status === 'Resolved') { %>
                  <span class="badge badge-resolved px-2 py-1"><i class="bi bi-check-circle me-1"></i>Resolved</span>
                <% } %>
              </td>
              <td class="small text-muted">
                <%= new Date(c.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td>
                <% if (c.resolution_notes) { %>
                  <div class="small text-success"><i class="bi bi-check2 me-1"></i> <%= c.resolution_notes %></div>
                <% } else { %>
                  <span class="small text-muted italic">Awaiting warden review</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
