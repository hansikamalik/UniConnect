<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/hostel/complaints" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        <h2 class="h4 mb-0 ms-2">Report Hostel Maintenance Issue</h2>
      </div>
      <p class="text-muted small">Resident Room: <strong><%= customHostelId %></strong>. Your request will be routed directly to your hostel warden.</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/hostel/complaints/new" method="POST" class="mt-3">
        <div class="mb-3">
          <label for="hostel_id" class="form-label fw-semibold small">Hostel Building</label>
          <select class="form-select" id="hostel_id" name="hostel_id" required>
            <option value="" disabled selected>Select your hostel</option>
            <% hostels.forEach(h => { %>
              <option value="<%= h.hostel_id %>"><%= h.name %> (<%= h.code %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label for="title" class="form-label fw-semibold small">Issue Title</label>
          <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Bathroom geyser not working / Broken table" required>
        </div>

        <div class="mb-4">
          <label for="description" class="form-label fw-semibold small">Detailed Description</label>
          <textarea class="form-control" id="description" name="description" rows="5" placeholder="Specify room details, exact issue, and when it started..." required></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/hostel/complaints" class="btn btn-light border">Cancel</a>
          <button type="submit" class="btn btn-sau-primary">
            <i class="bi bi-send me-1"></i> Submit Complaint
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
