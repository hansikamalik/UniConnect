<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6 text-center py-5">
    <div class="card sau-card p-5">
      <div class="d-inline-flex align-items-center justify-content-center bg-secondary-subtle text-secondary rounded-circle mb-3 mx-auto" style="width: 64px; height: 64px;">
        <i class="bi bi-house-slash fs-2"></i>
      </div>
      <h2 class="h4 mb-2">Hostel Services Disabled</h2>
      <p class="text-muted mb-4">
        You are currently registered as a <strong>Day Scholar</strong>. Hostel room maintenance and complaint tracking are strictly reserved for students residing in university hostels.
      </p>
      <div class="alert alert-light border small text-start mb-4">
        <i class="bi bi-info-circle me-1 text-primary"></i>
        If you have recently been allotted a hostel room, please contact the <strong>Hostel Warden</strong> or <strong>IT Administration</strong> to update your profile with your room ID.
      </div>
      <div>
        <a href="/dashboard" class="btn btn-sau-primary">
          <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
