<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/notices" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        <h2 class="h4 mb-0 ms-2">Publish Campus Notice</h2>
      </div>
      <p class="text-muted small">Broadcast official news, departmental updates, or administrative announcements.</p>

      <% if (locals.error) { %>
        <div class="alert alert-danger py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/notices/create" method="POST" class="mt-3">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold small">Notice Title</label>
          <input type="text" class="form-control" id="title" name="title" placeholder="e.g. End Semester Examination Schedule - Autumn 2026" required autofocus>
        </div>

        <div class="mb-4">
          <label for="body" class="form-label fw-semibold small">Notice Details / Content</label>
          <textarea class="form-control" id="body" name="body" rows="8" placeholder="Enter complete notice text, dates, guidelines, or instructions..." required></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/notices" class="btn btn-light border">Cancel</a>
          <button type="submit" class="btn btn-sau-primary">
            <i class="bi bi-send me-1"></i> Publish Notice
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
