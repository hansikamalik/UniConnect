<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card sau-card p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/notices" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> All Notices
        </a>
        <% if (canDelete) { %>
          <form action="/notices/<%= notice.notice_id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this notice? This action cannot be undone.');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-trash3 me-1"></i> Delete Notice
            </button>
          </form>
        <% } %>
      </div>

      <div class="border-bottom pb-3 mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-primary-subtle text-primary"><%= notice.author_role %></span>
          <span class="text-muted small">
            <i class="bi bi-clock me-1"></i>
            <%= new Date(notice.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
          </span>
        </div>
        <h1 class="h3 fw-bold text-dark mb-2"><%= notice.title %></h1>
        <div class="text-muted small">
          Published by <strong><%= notice.author_name %></strong>
        </div>
      </div>

      <div class="notice-body text-secondary" style="white-space: pre-wrap; line-height: 1.7; font-size: 1.02rem;">
        <%= notice.body %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
