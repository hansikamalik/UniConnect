<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5 col-xl-4">
    <div class="card sau-card p-4 p-sm-5 mt-4">
      <div class="login-header">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 56px; height: 56px;">
          <i class="bi bi-shield-lock-fill fs-3" style="color: var(--sau-blue);"></i>
        </div>
        <h1>UniConnect</h1>
        <p>Sign in with your university account</p>
      </div>

      <% if (locals.error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 small" role="alert">
          <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <% if (locals.success) { %>
        <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 small" role="alert">
          <i class="bi bi-check-circle-fill flex-shrink-0"></i>
          <div><%= success %></div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" class="mt-2">
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold small">Username</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control" id="username" name="username" value="<%= locals.username || '' %>" placeholder="e.g. admin or student ID" required autofocus>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold small">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
            <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
          </div>
        </div>

        <button type="submit" class="btn btn-sau-primary w-100 py-2">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </button>
      </form>

      <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 0.8rem;">
        <div>Need an account or forgot your password?</div>
        <div>Contact SAU IT Administration at <code>admin@sau.int</code></div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
